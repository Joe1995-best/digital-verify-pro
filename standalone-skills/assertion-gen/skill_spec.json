{
  "$schema": "https://digital-verify-pro.dev/schemas/skill_spec.v1.json",
  "name": "assertion-gen",
  "version": "1.0.0",
  "lifecycle": {
    "status": "beta",
    "last_reviewed": "2026-05-20"
  },
  "quality_score": 78.9,
  "description": "Generate SystemVerilog Assertions (SVA) from spec: interface protocols, internal invariants, register access rules, and timing requirements.",
  "interface": {
    "entry": "run.py",
    "signature": [
      {
        "name": "--spec",
        "type": "path",
        "required": false,
        "help": "YAML spec for context"
      },
      {
        "name": "--out",
        "type": "path",
        "required": false,
        "default": "output/",
        "help": "Output directory"
      },
      {
        "name": "--log-level",
        "type": "enum",
        "choices": [
          "debug",
          "info",
          "warn",
          "error"
        ],
        "default": "info",
        "help": "Log level"
      },
      {
        "name": "--format",
        "type": "enum",
        "choices": [
          "sv",
          "sva"
        ],
        "default": "sv",
        "help": "Assertion format"
      }
    ]
  },
  "inputs": {
    "files": {}
  },
  "outputs": {
    "result_json": {
      "path": "{out}/result.json",
      "schema": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "metrics",
          "outputs"
        ]
      }
    }
  },
  "dependencies": {
    "upstream": [
      "spec-analyzer"
    ],
    "downstream": [
      "tb-compiler",
      "sim-runner",
      "formal-check"
    ],
    "tools": [],
    "python_packages": [
      "pyyaml>=6.0",
      "jinja2"
    ]
  },
  "resource_limits": {
    "timeout_seconds": 300,
    "memory_mb": 1024
  },
  "error_codes": {
    "0": {
      "name": "SUCCESS",
      "fix": null
    },
    "1": {
      "name": "INPUT_ERROR",
      "fix": "Check CLI arguments"
    },
    "3": {
      "name": "RUNTIME_ERROR",
      "fix": "Check logs for details"
    },
    "99": {
      "name": "INTERNAL_ERROR",
      "fix": "Report bug"
    }
  },
  "tags": [
    "sva",
    "assertion",
    "generation"
  ]
}