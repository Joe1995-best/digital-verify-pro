{
  "$schema": "https://digital-verify-pro.dev/schemas/skill_spec.v1.json",
  "name": "scoreboard-gen",
  "version": "2.0.0",
  "lifecycle": {
    "status": "beta",
    "last_reviewed": "2026-05-20"
  },
  "quality_score": 79.4,
  "description": "UVM scoreboard and checker generator with TLM analysis ports, predictor, comparator, and coverage collection.",
  "interface": {
    "entry": "run.py",
    "signature": [
      {
        "name": "--spec",
        "type": "path",
        "required": false,
        "help": "YAML spec for context"
      },
      {
        "name": "--out",
        "type": "path",
        "required": false,
        "default": "output/",
        "help": "Output directory"
      },
      {
        "name": "--log-level",
        "type": "enum",
        "choices": [
          "debug",
          "info",
          "warn",
          "error"
        ],
        "default": "info",
        "help": "Log level"
      }
    ]
  },
  "inputs": {
    "files": {}
  },
  "outputs": {
    "result_json": {
      "path": "{out}/result.json",
      "schema": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "metrics",
          "outputs"
        ]
      }
    }
  },
  "dependencies": {
    "upstream": [
      "spec-analyzer",
      "env-builder"
    ],
    "downstream": [
      "tb-compiler",
      "sim-runner",
      "coverage-engine"
    ],
    "tools": [],
    "python_packages": [
      "pyyaml>=6.0",
      "jinja2"
    ]
  },
  "resource_limits": {
    "timeout_seconds": 300,
    "memory_mb": 1024
  },
  "error_codes": {
    "0": {
      "name": "SUCCESS",
      "fix": null
    },
    "1": {
      "name": "INPUT_ERROR",
      "fix": "Check CLI arguments"
    },
    "3": {
      "name": "RUNTIME_ERROR",
      "fix": "Check logs for details"
    },
    "99": {
      "name": "INTERNAL_ERROR",
      "fix": "Report bug"
    }
  },
  "tags": [
    "uvm",
    "scoreboard",
    "checker"
  ]
}