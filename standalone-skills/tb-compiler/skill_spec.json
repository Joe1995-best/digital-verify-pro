{
  "$schema": "https://digital-verify-pro.dev/schemas/skill_spec.v1.json",
  "name": "tb-compiler",
  "version": "1.0.0",
  "lifecycle": {
    "status": "development",
    "last_reviewed": "2026-05-20"
  },
  "quality_score": 76.4,
  "description": "Compile verification environment with EDA tool. COMPILE ONLY — generates compile scripts and optionally runs compilation. Does NOT execute simulation.",
  "interface": {
    "entry": "run.py",
    "signature": [
      {
        "name": "--spec",
        "type": "path",
        "required": false,
        "help": "YAML spec for context"
      },
      {
        "name": "--out",
        "type": "path",
        "required": false,
        "default": "output/",
        "help": "Output directory"
      },
      {
        "name": "--log-level",
        "type": "enum",
        "choices": [
          "debug",
          "info",
          "warn",
          "error"
        ],
        "default": "info",
        "help": "Log level"
      },
      {
        "name": "--tool",
        "type": "enum",
        "choices": [
          "auto",
          "iverilog",
          "verilator",
          "vcs",
          "questa"
        ],
        "default": "auto",
        "help": "Simulator"
      },
      {
        "name": "--check-only",
        "type": "boolean",
        "required": false,
        "help": "RTL syntax check only"
      }
    ]
  },
  "inputs": {
    "files": {}
  },
  "outputs": {
    "result_json": {
      "path": "{out}/result.json",
      "schema": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "metrics",
          "outputs"
        ]
      }
    }
  },
  "dependencies": {
    "upstream": [
      "env-builder",
      "test-generator",
      "assertion-gen",
      "scoreboard-gen",
      "coverage-plan",
      "regmodel-gen"
    ],
    "downstream": [
      "sim-runner"
    ],
    "tools": [],
    "python_packages": [
      "jinja2"
    ]
  },
  "resource_limits": {
    "timeout_seconds": 300,
    "memory_mb": 1024
  },
  "error_codes": {
    "0": {
      "name": "SUCCESS",
      "fix": null
    },
    "1": {
      "name": "INPUT_ERROR",
      "fix": "Check CLI arguments"
    },
    "3": {
      "name": "RUNTIME_ERROR",
      "fix": "Check logs for details"
    },
    "99": {
      "name": "INTERNAL_ERROR",
      "fix": "Report bug"
    }
  },
  "tags": [
    "compilation",
    "uvm"
  ]
}