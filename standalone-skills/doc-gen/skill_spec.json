{
  "$schema": "https://digital-verify-pro.dev/schemas/skill_spec.v1.json",
  "name": "doc-gen",
  "version": "1.0.0",
  "lifecycle": {
    "status": "stable",
    "last_reviewed": "2026-05-20"
  },
  "quality_score": 77.4,
  "description": "Generate verification close documentation from all verification artifacts: file inventory, test summary, sign-off report.",
  "interface": {
    "entry": "run.py",
    "signature": [
      {
        "name": "--spec",
        "type": "path",
        "required": false,
        "help": "YAML spec for context"
      },
      {
        "name": "--out",
        "type": "path",
        "required": false,
        "default": "output/",
        "help": "Output directory"
      },
      {
        "name": "--log-level",
        "type": "enum",
        "choices": [
          "debug",
          "info",
          "warn",
          "error"
        ],
        "default": "info",
        "help": "Log level"
      }
    ]
  },
  "inputs": {
    "files": {}
  },
  "outputs": {
    "result_json": {
      "path": "{out}/result.json",
      "schema": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "metrics",
          "outputs"
        ]
      }
    }
  },
  "dependencies": {
    "upstream": [
      "env-builder",
      "test-generator",
      "assertion-gen",
      "scoreboard-gen",
      "coverage-plan",
      "sim-runner",
      "waveform-analyzer"
    ],
    "downstream": [],
    "tools": [],
    "python_packages": [
      "jinja2"
    ]
  },
  "resource_limits": {
    "timeout_seconds": 300,
    "memory_mb": 1024
  },
  "error_codes": {
    "0": {
      "name": "SUCCESS",
      "fix": null
    },
    "1": {
      "name": "INPUT_ERROR",
      "fix": "Check CLI arguments"
    },
    "3": {
      "name": "RUNTIME_ERROR",
      "fix": "Check logs for details"
    },
    "99": {
      "name": "INTERNAL_ERROR",
      "fix": "Report bug"
    }
  },
  "tags": [
    "documentation",
    "sign-off"
  ]
}