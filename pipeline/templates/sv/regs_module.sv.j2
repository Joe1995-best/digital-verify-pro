{# regs_module.sv.j2 — 寄存器模块模板 #}
// Auto-generated by digital-verify-pro template engine
// Module: {{ module_name }}_regs
// {{ date }}

module {{ module_name }}_regs (
{% for port in ports %}
  {{ port.direction }}  logic {% if port.width > 1 %}[{{ port.width }}-1:0] {% endif %}{{ port.name }}{% if not loop.last %},{% endif %}
{% endfor %}
);

{% for r in registers %}
  // ── {{ r.name }} (offset {{ r.offset }}) ──
  {% if r.is_wire %}wire{% else %}logic{% endif %} [31:0] {{ r.name }}_q;
  {% if not r.is_wire %}
  logic [31:0] {{ r.name }}_next;
  {% endif %}
{% endfor %}

{% if has_fsm %}
  // FSM status inputs
{% for sig in fsm_status_inputs %}
  input logic {{ sig }},
{% endfor %}
{% endif %}

  // Reset values
{% for r in registers %}
  localparam {{ r.name }}_RST = 32'h{{ r.reset }};
{% endfor %}

  // APB write
  always_ff @(posedge clk or negedge rstn) begin
    if (!rstn) begin
{% for r in registers %}
      {{ r.name }}_q <= {{ r.name }}_RST;
{% endfor %}
    end else if (psel && penable && pwrite) begin
      case (paddr)
{% for r in registers %}
     12'h{{ r.offset[2:] }}: {{ r.name }}_q <= {{ r.write_expr }};
{% endfor %}
      endcase
    end
  end

  // APB read
  always_comb begin
    prdata = '0;
    if (psel && !pwrite) begin
      case (paddr)
{% for r in registers %}
     12'h{{ r.offset[2:] }}: prdata = {{ r.name }}_q;
{% endfor %}
      endcase
    end
  end

endmodule
